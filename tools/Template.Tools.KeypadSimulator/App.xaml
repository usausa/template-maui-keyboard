<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="http://smart/windows"
             xmlns:behaviors="clr-namespace:Template.Tools.KeypadSimulator.Behaviors"
             xmlns:models="clr-namespace:Template.Tools.KeypadSimulator.Models"
             x:Class="Template.Tools.KeypadSimulator.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ================================================================================ -->
            <!-- Import -->
            <!-- ================================================================================ -->

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ================================================================================ -->
            <!-- Converter -->
            <!-- ================================================================================ -->

            <s:ReverseConverter x:Key="ReverseConverter" />

            <!-- ================================================================================ -->
            <!-- Color -->
            <!-- ================================================================================ -->

            <SolidColorBrush x:Key="KeypadBodyBrush"
                             Color="#2C2C2A" />
            <SolidColorBrush x:Key="NumberKeyBrush"
                             Color="#F1EFE8" />
            <SolidColorBrush x:Key="NumberKeyTextBrush"
                             Color="#2C2C2A" />
            <SolidColorBrush x:Key="NumberKeyBorderBrush"
                             Color="#5F5E5A" />
            <SolidColorBrush x:Key="ControlKeyBrush"
                             Color="#444441" />
            <SolidColorBrush x:Key="ControlKeyTextBrush"
                             Color="#F1EFE8" />
            <SolidColorBrush x:Key="ControlKeyBorderBrush"
                             Color="#2C2C2A" />
            <SolidColorBrush x:Key="Function1KeyBrush"
                             Color="#E24B4A" />
            <SolidColorBrush x:Key="Function1KeyTextBrush"
                             Color="#FCEBEB" />
            <SolidColorBrush x:Key="Function1KeyBorderBrush"
                             Color="#A32D2D" />
            <SolidColorBrush x:Key="Function2KeyBrush"
                             Color="#378ADD" />
            <SolidColorBrush x:Key="Function2KeyTextBrush"
                             Color="#E6F1FB" />
            <SolidColorBrush x:Key="Function2KeyBorderBrush"
                             Color="#185FA5" />
            <SolidColorBrush x:Key="Function3KeyBrush"
                             Color="#639922" />
            <SolidColorBrush x:Key="Function3KeyTextBrush"
                             Color="#EAF3DE" />
            <SolidColorBrush x:Key="Function3KeyBorderBrush"
                             Color="#3B6D11" />
            <SolidColorBrush x:Key="Function4KeyBrush"
                             Color="#EF9F27" />
            <SolidColorBrush x:Key="Function4KeyTextBrush"
                             Color="#412402" />
            <SolidColorBrush x:Key="Function4KeyBorderBrush"
                             Color="#854F0B" />
            <SolidColorBrush x:Key="KeyPressedBrush"
                             Color="#59000000" />

            <!-- ================================================================================ -->
            <!-- Style -->
            <!-- ================================================================================ -->

            <Style x:Key="KeypadKey"
                   TargetType="Button">
                <Setter Property="Height" Value="44" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{StaticResource NumberKeyBrush}" />
                <Setter Property="Foreground" Value="{StaticResource NumberKeyTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NumberKeyBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Content" Value="{Binding (behaviors:KeyPress.Key).Label, RelativeSource={RelativeSource Self}, FallbackValue={x:Null}}" />
                <Setter Property="behaviors:KeyPress.PressCommand" Value="{Binding PressCommand}" />
                <Setter Property="behaviors:KeyPress.ReleaseCommand" Value="{Binding ReleaseCommand}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="Pressed"
                                        Visibility="Collapsed"
                                        Background="{StaticResource KeyPressedBrush}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Pressed" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding (behaviors:KeyPress.Key).Kind, RelativeSource={RelativeSource Self}, FallbackValue={x:Null}}"
                                 Value="{x:Static models:KeyKind.Control}">
                        <Setter Property="Background" Value="{StaticResource ControlKeyBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource ControlKeyTextBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource ControlKeyBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding (behaviors:KeyPress.Key).Kind, RelativeSource={RelativeSource Self}, FallbackValue={x:Null}}"
                                 Value="{x:Static models:KeyKind.Function1}">
                        <Setter Property="Background" Value="{StaticResource Function1KeyBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource Function1KeyTextBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Function1KeyBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding (behaviors:KeyPress.Key).Kind, RelativeSource={RelativeSource Self}, FallbackValue={x:Null}}"
                                 Value="{x:Static models:KeyKind.Function2}">
                        <Setter Property="Background" Value="{StaticResource Function2KeyBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource Function2KeyTextBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Function2KeyBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding (behaviors:KeyPress.Key).Kind, RelativeSource={RelativeSource Self}, FallbackValue={x:Null}}"
                                 Value="{x:Static models:KeyKind.Function3}">
                        <Setter Property="Background" Value="{StaticResource Function3KeyBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource Function3KeyTextBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Function3KeyBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding (behaviors:KeyPress.Key).Kind, RelativeSource={RelativeSource Self}, FallbackValue={x:Null}}"
                                 Value="{x:Static models:KeyKind.Function4}">
                        <Setter Property="Background" Value="{StaticResource Function4KeyBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource Function4KeyTextBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Function4KeyBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="HeaderLabel"
                   TargetType="TextBlock">
                <Setter Property="Width" Value="64" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
            </Style>

            <Style x:Key="HeaderRow"
                   TargetType="DockPanel">
                <Setter Property="Height" Value="32" />
                <Setter Property="LastChildFill" Value="True" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
