<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Key"
             xmlns:input="clr-namespace:Template.MobileApp.Input"
             x:Class="Template.MobileApp.Modules.Key.KeyListView"
             x:DataType="{x:Type module:KeyListViewModel}"
             s:BindingContextResolver.Type="{x:Type module:KeyListViewModel}"
             shell:ShellProperty.Title="List"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <Grid Style="{StaticResource MenuGrid}"
          RowDefinitions="Auto,*">
        <Label Grid.Row="0"
               Style="{StaticResource ResultLabel}"
               Text="{Binding Result, StringFormat='Result: {0}'}" />
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single">
            <CollectionView.Behaviors>
                <input:CollectionViewShortcutBehavior Command="{Binding SelectCommand}"
                                                      KeyCode="Enter"
                                                      SelectByNumberKey="True" />
            </CollectionView.Behaviors>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Grid Style="{StaticResource ItemCollectionGrid}">
                        <Label Style="{StaticResource ItemCollectionLabel}"
                               Text="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentView>
